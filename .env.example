# EduBridge Production & Development Configuration
SECRET_KEY=your-secret-key-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,.vercel.app
CSRF_TRUSTED_ORIGINS=https://*.vercel.app,http://localhost:8000

# Biometrics
FACE_RECOGNITION_THRESHOLD=0.85

# Higher-Education Data APIs
COLLEGE_SCORECARD_API_KEY=your-data-gov-api-key-here

# Databases & Cache
# Local Demo mode uses SQLite fallback automatically
DATABASE_URL=postgres://edubridge_user:password@localhost:5432/edubridge_db
REDIS_URL=redis://localhost:6379/0

# Firebase Firestore (Optional in Demo Mode)
FIREBASE_CREDENTIALS_PATH=firebase_credentials.json
FIREBASE_PROJECT_ID=your-firebase-project-id

# AI & RAG Engine
ANTHROPIC_API_KEY=your-anthropic-api-key-here
SITE_NAME=EduBridge
